# Copie para .env e preencha. O arquivo .env NÃO deve ser versionado.

# Obrigatório — a aplicação não sobe sem isto.
# Gere um valor com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Servidor de desenvolvimento. Nunca ligue FLASK_DEBUG fora da sua máquina:
# o debugger do Werkzeug permite execução remota de código.
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Caminho do banco SQLite (relativo à raiz do projeto ou absoluto).
DB_PATH=loja.db

# Origens liberadas para CORS, separadas por vírgula.
# Vazio = nenhuma origem cross-site liberada (default fechado).
CORS_ORIGINS=

# Validade do token de sessão emitido no /login, em segundos (24h).
TOKEN_TTL_SEGUNDOS=86400

LOG_LEVEL=INFO
